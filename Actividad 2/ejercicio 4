        Trapecio figura6 =
                new Trapecio(
                        10,
                        6,
                        4,
                        5,
                        5);

        System.out.println(
                "Area circulo = "
                + figura1.calcularArea());

        System.out.println(
                "Perimetro circulo = "
                + figura1.calcularPerimetro());

        System.out.println();

        System.out.println(
                "Area rectangulo = "
