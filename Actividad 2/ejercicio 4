        System.out.println(
                "Perimetro rectangulo = "
                + figura2.calcularPerimetro());

        System.out.println();

        System.out.println(
                "Area cuadrado = "
                + figura3.calcularArea());

        System.out.println(
                "Perimetro cuadrado = "
                + figura3.calcularPerimetro());

        System.out.println();

        System.out.println(
                "Area triangulo = "
                + figura4.calcularArea());

        System.out.println(
                "Perimetro triangulo = "
